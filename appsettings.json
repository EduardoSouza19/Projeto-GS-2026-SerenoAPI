{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "sereno-auth",
    "Audience": "sereno-app",
    "ExpiracaoHoras": 2
  },
  "MongoDbSettings": {
    "DatabaseName": "sereno"
  },
  "RateLimit": {
    "GeralPorMinuto": 100,
    "ReportesPorMinuto": 10
  }
}
